{
  "name": "render-tag",
  "version": "0.1.33",
  "type": "module",
  "description": "Render HTML rich text onto canvas using pure 2D API",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "node": "./lib/index.node.js",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./path": {
      "types": "./lib/path/index.d.ts",
      "node": "./lib/path/index.node.js",
      "import": "./lib/path/index.js",
      "default": "./lib/path/index.js"
    },
    "./umd": "./lib/render-tag.umd.js"
  },
  "homepage": "https://polotno.com/render-tag/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polotno-project/render-tag.git"
  },
  "license": "MIT",
  "author": "Anton Lavrenov",
  "keywords": [
    "canvas",
    "html",
    "rich-text",
    "text-rendering",
    "html-to-canvas",
    "canvas-text",
    "design-editor",
    "image-export",
    "foreignObject",
    "fillText",
    "html2canvas"
  ],
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --config docs/vite.config.ts",
    "test": "npm run test:browser && npm run test:node",
    "test:browser": "vitest run --exclude='tests/node/**' --exclude='tests/generate-baselines.test.ts' --exclude='tests/cross-browser.compare.test.ts' --exclude='tests/cross-browser.record.test.ts' --exclude='tests/wrap-debug.test.ts' --exclude='tests/wrap-sweep.test.ts' --exclude='tests/perf.test.ts' --exclude='tests/list-marker-parity.test.ts' --exclude='tests/svg-oracle-parity.test.ts'",
    "test:svg-oracle": "vitest run tests/svg-oracle-parity.test.ts",
    "test:node": "vitest run -c vitest.node.config.ts",
    "test:update-baselines": "vitest run tests/generate-baselines.test.ts",
    "test:update-baselines:firefox": "vitest run tests/generate-baselines.test.ts -c vitest.firefox.config.ts",
    "test:update-baselines:webkit": "vitest run tests/generate-baselines.test.ts -c vitest.webkit.config.ts",
    "test:stress": "vitest run tests/stress.test.ts",
    "test:update-stress-baseline": "vitest run tests/stress.test.ts --mode update-stress",
    "test:update-stress-baseline:firefox": "vitest run tests/stress.test.ts -c vitest.firefox.config.ts --mode update-stress",
    "test:update-stress-baseline:webkit": "vitest run tests/stress.test.ts -c vitest.webkit.config.ts --mode update-stress",
    "test:wrap-sweep": "vitest run tests/wrap-sweep.test.ts",
    "test:wrap-sweep:firefox": "vitest run tests/wrap-sweep.test.ts -c vitest.firefox.config.ts",
    "test:wrap-sweep:webkit": "vitest run tests/wrap-sweep.test.ts -c vitest.webkit.config.ts",
    "test:update-wrap-sweep-baseline": "vitest run tests/wrap-sweep.test.ts --mode update-wrap-sweep",
    "test:update-wrap-sweep-baseline:firefox": "vitest run tests/wrap-sweep.test.ts -c vitest.firefox.config.ts --mode update-wrap-sweep",
    "test:update-wrap-sweep-baseline:webkit": "vitest run tests/wrap-sweep.test.ts -c vitest.webkit.config.ts --mode update-wrap-sweep",
    "test:firefox": "vitest run -c vitest.firefox.config.ts",
    "test:webkit": "vitest run -c vitest.webkit.config.ts",
    "test:clear-native-cache": "node tests/clear-native-cache.mjs",
    "test:safari-native": "node tests/run-safari-native.mjs",
    "test:cross-browser:record": "vitest run tests/cross-browser.record.test.ts",
    "test:cross-browser:firefox": "vitest run tests/cross-browser.compare.test.ts -c vitest.firefox.config.ts",
    "test:cross-browser:webkit": "vitest run tests/cross-browser.compare.test.ts -c vitest.webkit.config.ts",
    "test:update-cross-browser-baseline:firefox": "vitest run tests/cross-browser.compare.test.ts -c vitest.firefox.config.ts --mode update-cross-browser",
    "test:update-cross-browser-baseline:webkit": "vitest run tests/cross-browser.compare.test.ts -c vitest.webkit.config.ts --mode update-cross-browser",
    "build": "tsc && vite build --config vite.umd.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/arimo": "5.3.0",
    "@fontsource-variable/inconsolata": "5.3.0",
    "@fontsource-variable/merriweather": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/noto-sans-khmer": "5.3.0",
    "@fontsource-variable/noto-sans-myanmar": "5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource-variable/open-sans": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource/lobster": "5.3.0",
    "@fontsource/noto-emoji": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@vitest/browser": "^4",
    "@vitest/browser-playwright": "^4.1.2",
    "linkedom": "^0.18",
    "pixelmatch": "^7",
    "playwright": "^1",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
